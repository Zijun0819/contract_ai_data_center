# Versioned experiment archives are uploaded as GitHub Release assets.
/release_assets/

# Keep only the default example, input documentation, and manifests in Git.
# Full experiment inputs remain on disk and can be restored by download_data.py.
/data/**
!/data/**/
!/data/**/*.md
!/data/**/*manifest.json
